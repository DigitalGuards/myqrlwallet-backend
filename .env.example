# Server Configuration
PORT=3000
LISTEN_HOST=127.0.0.1
NODE_ENV=development

# Cache Configuration
CACHE_TTL=10

# RPC Endpoints
RPC_ENDPOINT_DEV=http://localhost:8545
RPC_ENDPOINT_TESTNET=your_testnet_endpoint
RPC_ENDPOINT_MAINNET=your_mainnet_endpoint

# Optional paired identity pins, with DEV, TESTNET, or MAINNET suffixes.
# Set both to the intended network's positive decimal chain ID and genesis hash.
# Leave both absent to disable binding. Blank or partial values stop startup.
# RPC_EXPECTED_CHAIN_ID_TESTNET=<positive-decimal-chain-id>
# RPC_EXPECTED_GENESIS_HASH_TESTNET=<0x-prefixed-32-byte-genesis-hash>

# CORS Configuration
ALLOWED_ORIGINS=https://example1.com,https://example2.com

# Comma-separated proxy peer CIDRs allowed to supply X-Forwarded-For.
# Production defaults to loopback for nginx-on-the-same-host. Development
# defaults to no trusted proxies. Set explicit peer CIDRs for other topologies.
TRUSTED_PROXY_CIDRS=

# Networks that must have at least one actively advancing RPC endpoint for /health.
RPC_REQUIRED_NETWORKS=testnet

# Readiness requires a recent head, qrl_syncing=false, and bounded lag against
# other fresh endpoints. A poll expires after three poll intervals.
RPC_MAX_HEAD_AGE_MS=300000
RPC_MAX_HEAD_FUTURE_MS=60000
RPC_MAX_LAG_BLOCKS=8

# Fixed history origins per network. Blank means history is unavailable.
# Local development may use a loopback HTTP explorer origin.
TX_HISTORY_ORIGIN_TESTNET=https://zondscan.com
TX_HISTORY_ORIGIN_MAINNET=
TX_HISTORY_ORIGIN_DEV=

# RPC response and aggregate admission limits. RPC_MAX_INFLIGHT_BYTES must be
# at least RPC_MAX_RESPONSE_BYTES or all upstream calls fail closed as busy.
RPC_RATE_LIMIT_PER_MINUTE=1000
RPC_WRITE_RATE_LIMIT_PER_MINUTE=10
RPC_MAX_RESPONSE_BYTES=8388608
RPC_MAX_CONCURRENT=16
# Upstream calls one client address may hold at once (must stay below RPC_MAX_CONCURRENT).
RPC_MAX_CONCURRENT_PER_CLIENT=4
# Leave unset to use RPC_MAX_CONCURRENT x RPC_MAX_RESPONSE_BYTES. A smaller value
# lowers the effective concurrency to INFLIGHT / RESPONSE.
# RPC_MAX_INFLIGHT_BYTES=134217728

# Ordered HTTPS gateways. An explicit list takes precedence over IPFS_GATEWAY.
# Leave both absent to use this default list. Blank or invalid entries stop startup.
# ipfs.io and dweb.link permanently retired HTTP serving in September 2026.
# Filebase leads after fast responses with correct content types in gateway probes.
# Pinata is a slow late fallback and serves a Cloudflare JS challenge under load
# with status 429 and no Retry-After. A self-hosted gateway is the durable option;
# operators can point IPFS_GATEWAYS at its HTTPS /ipfs/ base URL.
# Each URL requires a DNS hostname, a nonzero port, and the normalized /ipfs/ base path.
# IPFS_GATEWAYS=https://ipfs.filebase.io/ipfs/,https://gateway.pinata.cloud/ipfs/
# IPFS_GATEWAY=https://ipfs.filebase.io/ipfs/

# IPFS and relay memory admission limits. The timeout covers all gateway attempts
# and streaming together.
IPFS_FETCH_TIMEOUT_MS=8000
# Reserve per eligible later gateway, with a 250 ms minimum.
IPFS_FALLBACK_RESERVE_MS=1000
# Retry-After cap, with a 15 minute minimum.
IPFS_MAX_COOLDOWN_MS=900000
# A 30 second cooldown requires 502, 503 or 504 for this many distinct root CIDs
# within the rolling window. The CID threshold has a minimum of 3. Repeated
# failures for one CID count once. A 500 or other 5xx still falls through.
IPFS_SERVER_ERROR_MIN_CIDS=3
IPFS_SERVER_ERROR_WINDOW_MS=60000
IPFS_MAX_SIZE_BYTES=10485760
IPFS_MAX_CONCURRENT=8
IPFS_MAX_INFLIGHT_BYTES=41943040
RELAY_MAX_BUFFERED_BYTES_PER_CHANNEL=2097152
RELAY_MAX_BUFFERED_BYTES_PER_IP=8388608
RELAY_MAX_BUFFERED_BYTES_GLOBAL=67108864
