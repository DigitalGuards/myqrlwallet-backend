{
  "name": "qrl-wallet-backend",
  "version": "1.0.0",
  "description": "Backend service for QRL Web Wallet",
  "main": "server.js",
  "type": "module",
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "diff": "^8.0.3"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha --experimental-modules --recursive 'test/**/*.test.js'",
    "lint": "eslint src/ server.js --ext .js",
    "lint:fix": "eslint src/ server.js --ext .js --fix",
    "format": "prettier --write 'src/**/*.js' server.js",
    "format:check": "prettier --check 'src/**/*.js' server.js"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "chai-http": "^5.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^11.1.0",
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.0",
    "sinon": "^19.0.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0"
  }
}
