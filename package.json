{
  "name": "qrl-wallet-backend",
  "version": "1.0.0",
  "description": "Backend service for QRL Web Wallet",
  "main": "server.js",
  "type": "module",
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "smoke:boot": "node scripts/smoke-boot.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "mocha --node-option=import=tsx --recursive 'test/**/*.test.js'",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.js' server.js",
    "lint:fix": "eslint 'src/**/*.ts' 'test/**/*.js' server.js --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.js' server.js",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.js' server.js"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "node-cache": "^5.1.2",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "proxy-addr": "^2.0.7",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.21",
    "@types/proxy-addr": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.61.0",
    "chai": "^5.2.0",
    "chai-http": "^5.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^11.8.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.6",
    "sinon": "^19.0.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
